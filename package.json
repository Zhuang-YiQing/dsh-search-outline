{
  "name": "dsh-search-outline",
  "version": "0.5.0",
  "description": "DSH 文件预览增强：接管 better-sidebar 预览，内置 Ctrl+F 查找条（正则 / 区分大小写 / 命中高亮）、结构大纲（Java / JS / TS / Python / HTML 的类 / 方法 / 变量 / 元素、Markdown 标题大纲）、Markdown 渲染预览（可切回源码），并支持选中文本右键加入对话；所有文本格式可搜。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhuang-YiQing/dsh-search-outline.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "code-search",
    "outline",
    "structure",
    "markdown-preview",
    "file-preview"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}



